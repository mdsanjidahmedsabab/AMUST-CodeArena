generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum Difficulty {
  Easy
  Medium
  Hard
}

enum ProblemSource {
  local
  cf
  cc
  leetcode
  hackerrank
}

enum Language {
  C
  CPP
  JAVA
  JAVASCRIPT
  PYTHON
}

enum Verdict {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT
  MEMORY_LIMIT
  RUNTIME_ERROR
  COMPILATION_ERROR
}

enum ContestStatus {
  DRAFT
  UPCOMING
  RUNNING
  ENDED
  FINISHED
}

enum SessionMode {
  CONTEST
  PRACTICE
  TRAINING
}

enum TopicTag {
  DP
  GRAPHS
  GREEDY
  MATH
  STRINGS
  IMPLEMENTATION
  BINARY_SEARCH
  SORTING
  TWO_POINTERS
  TREE
  GEOMETRY
  BITMASK
}

enum ViolationType {
  TAB_SWITCH
  WINDOW_BLUR
  FULLSCREEN_EXIT
  PASTE_BURST
  MULTIPLE_DISPLAYS
  UNAUTHORIZED_DEVICE
  HEARTBEAT
}

enum ViolationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ── Models ──

model User {
  id                String      @id @default(cuid())
  email             String      @unique
  universityId      String?     @unique @map("university_id")
  name              String
  passwordHash      String      @map("password_hash")
  role              Role        @default(STUDENT)
  isVerified        Boolean     @default(true) @map("is_verified")
  isSuperAdmin      Boolean     @default(false) @map("is_super_admin")
  rating            Int         @default(1200)
  tier              String      @default("Newbie")
  sessionMode       SessionMode @default(PRACTICE)
  refreshTokenHash  String?     @map("refresh_token_hash")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  submissions         Submission[]
  ratingHistory       UserRatingHistory[]
  contestParticipants ContestParticipant[]
  proctorLogs         ProctorLog[]

  @@map("users")
}

model Problem {
  id               String        @id @default(cuid())
  title            String
  source           ProblemSource @default(local)
  sourceId         String?       @map("remote_problem_id")
  directUrl        String?       @map("direct_url")
  difficulty       Difficulty
  rating           Int           @default(800)
  timeLimit        Int           @default(1000) @map("time_limit")
  memoryLimit      Int           @default(256) @map("memory_limit")
  statementCache   String?       @map("statement_cache") @db.Text
  sampleTestcases  Json?         @map("sample_testcases")
  cachedAt         DateTime?     @map("cached_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  tags             ProblemTag[]
  submissions      Submission[]
  contestProblems  ContestProblem[]

  @@unique([source, sourceId])
  @@index([difficulty, rating])
  @@index([cachedAt])
  @@map("problems")
}

model ProblemTag {
  id        String   @id @default(cuid())
  problemId String   @map("problem_id")
  tag       TopicTag

  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, tag])
  @@index([tag])
  @@map("problem_tags")
}

model Contest {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?       @db.Text
  status      ContestStatus @default(UPCOMING)
  startTime   DateTime      @map("start_time")
  endTime     DateTime      @map("end_time")
  freezeTime  DateTime?     @map("freeze_time")
  isPrivate   Boolean       @default(false) @map("is_private")
  accessCode  String?       @map("access_code")
  createdBy   String        @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  problems     ContestProblem[]
  participants ContestParticipant[]
  submissions  Submission[]
  proctorLogs  ProctorLog[]

  @@index([startTime, endTime])
  @@map("contests")
}

model ContestProblem {
  id        String  @id @default(cuid())
  contestId String  @map("contest_id")
  problemId String  @map("problem_id")
  label     String  // e.g., "A", "B", "C"
  order     Int     @default(0)
  points    Int     @default(100)

  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([contestId, problemId])
  @@unique([contestId, label])
  @@map("contest_problems")
}

model ContestParticipant {
  id               String    @id @default(cuid())
  contestId        String    @map("contest_id")
  userId           String    @map("user_id")
  registeredAt     DateTime  @default(now()) @map("registered_at")
  penalty          Int       @default(0)
  solved           Int       @default(0)
  isDisqualified   Boolean   @default(false) @map("is_disqualified")
  disqualifiedAt   DateTime? @map("disqualified_at")
  disqualifyReason String?   @map("disqualify_reason")
  warningsCount    Int       @default(0) @map("warnings_count")
  integrityScore   Int       @default(100) @map("integrity_score")
  lastHeartbeat    DateTime? @map("last_heartbeat")

  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@map("contest_participants")
}

model ProctorLog {
  id           String            @id @default(cuid())
  contestId    String            @map("contest_id")
  userId       String            @map("user_id")
  eventType    ViolationType     @map("event_type")
  severity     ViolationSeverity @default(LOW)
  metadata     Json?
  snapshotDiff String?           @map("snapshot_diff") @db.Text
  flagged      Boolean           @default(false)
  createdAt    DateTime          @default(now()) @map("created_at")

  contest      Contest           @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contestId, userId])
  @@index([contestId, createdAt])
  @@map("proctor_logs")
}

model Submission {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  problemId  String   @map("problem_id")
  contestId  String?  @map("contest_id")
  language   Language
  sourceCode String   @map("source_code") @db.Text
  verdict    Verdict  @default(PENDING)
  timeMs     Int?     @map("time_ms")
  memoryKb   Int?     @map("memory_kb")
  reportHash String?  @map("report_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  contest Contest? @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@index([contestId, userId])
  @@index([contestId, createdAt])
  @@map("submissions")
}

model UserRatingHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  contestId String   @map("contest_id")
  oldRating Int      @map("old_rating")
  newRating Int      @map("new_rating")
  delta     Int
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_rating_history")
}
