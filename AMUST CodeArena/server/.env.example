# ── Database ──
DATABASE_URL="postgresql://codearena:codearena@localhost:5432/codearena?schema=public"

# ── Redis ──
REDIS_URL="redis://localhost:6379"

# ── JWT ──
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

# ── Judge0 CE ──
JUDGE0_URL="http://localhost:2358"

# ── Codeforces API ──
CF_API_KEY=""
CF_API_SECRET=""

# ── Google Gemini ──
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# ── App ──
PORT=5000
NODE_ENV=development

# ── Auth (additional) ──
JWT_REFRESH_SECRET="CHANGE_ME_TO_ANOTHER_RANDOM_SECRET"
CLIENT_URL="https://codearena.amust.edu.bd"
