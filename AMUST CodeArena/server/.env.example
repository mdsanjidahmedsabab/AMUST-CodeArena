# ── Server Environment Variables Template ─────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# Database & Redis
DATABASE_URL="postgresql://codearena:your_secure_db_password_here@localhost:5432/codearena?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="generate_a_secure_jwt_secret_key_minimum_32_characters"
JWT_ACCESS_SECRET="generate_a_secure_jwt_access_secret_key_minimum_32_characters"
JWT_REFRESH_SECRET="generate_a_secure_jwt_refresh_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="15m"

# Email OTP Service
EMAIL_USER="your_smtp_username_or_email@gmail.com"
EMAIL_PASS="your_smtp_app_password_or_token"
# Brevo (Sendinblue) Transactional Email Service (HTTPS Port 443 - Recommended for Cloud / Render)
BREVO_API_KEY="xkeysib-your_brevo_api_key_here"
BREVO_SENDER_EMAIL="sababsanjid2@gmail.com"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your_smtp_username_or_email@gmail.com"
SMTP_PASS="your_smtp_app_password_or_token"
SMTP_FROM="\"AMUST CodeArena\" <noreply@amust.ac.bd>"
OTP_SECRET="generate_a_secure_random_otp_salt_key"

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Docker & Judge0 Sandbox
DOCKER_JUDGE_IMAGE="amust-codearena/judge-runner:latest"
DOCKER_TIMEOUT_MS=3000
JUDGE0_URL="http://localhost:2358"

# External OJ Keys & Shared Bot Pool
CF_API_KEY=""
CF_API_SECRET=""
DEFAULT_CF_BOT_HANDLE="your_cf_bot_handle"
DEFAULT_CF_BOT_PASSWORD="your_cf_bot_password"
REMOTE_AUTH_SECRET="your_32_byte_secret_hex_or_string"
