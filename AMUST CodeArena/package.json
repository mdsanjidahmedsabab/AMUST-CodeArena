{
  "name": "amust-codearena",
  "private": true,
  "version": "0.1.0",
  "description": "AMUST CodeArena — Hybrid Virtual Online Judge & Academic LMS",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "start:prod": "docker compose up --build",
    "build": "npm -w client run build",
    "test": "node server/test/run_all_tests.js",
    "test:all": "node server/test/run_all_tests.js",
    "audit:security": "node scripts/verify-security.js",
    "seed": "npm -w server run db:seed",
    "seed:all-problems": "node server/prisma/seed_multiplatform_1500.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "npm -w server run db:generate",
    "db:migrate": "npm -w server run db:migrate",
    "db:push": "npm -w server run db:push",
    "db:seed": "npm -w server run db:seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "dependencies": {
    "@getbrevo/brevo": "^2.2.0"
  }
}
