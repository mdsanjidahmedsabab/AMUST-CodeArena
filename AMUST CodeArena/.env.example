# ─────────────────────────────────────────────────────────────────────────────
# AMUST CodeArena — Production & Development Environment Template
# Copy this file to .env and configure keys accordingly.
# NEVER commit your actual .env file with real credentials to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# Server & Network Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost

# PostgreSQL 16 Database
POSTGRES_USER=codearena
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=codearena
POSTGRES_PORT=5432
DATABASE_URL="postgresql://codearena:your_secure_db_password_here@localhost:5432/codearena?schema=public"

# Redis 7 In-Memory Cache & BullMQ Queue
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# JWT Authentication Secrets (Generate 64+ char random strings)
JWT_SECRET="generate_a_secure_jwt_secret_key_minimum_32_characters"
JWT_ACCESS_SECRET="generate_a_secure_jwt_access_secret_key_minimum_32_characters"
JWT_REFRESH_SECRET="generate_a_secure_jwt_refresh_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="15m"

# Email OTP Service & SMTP Transport
EMAIL_USER="your_smtp_username_or_email@gmail.com"
EMAIL_PASS="your_smtp_app_password_or_token"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_smtp_username_or_email@gmail.com"
SMTP_PASS="your_smtp_app_password_or_token"
SMTP_FROM="\"AMUST CodeArena\" <noreply@amust.ac.bd>"
OTP_SECRET="generate_a_secure_random_otp_salt_key"

# Google Gemini API (Socratic AI Tutor & Edge Case Generator)
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Docker Sandbox Code Runner
DOCKER_JUDGE_IMAGE="amust-codearena/judge-runner:latest"
DOCKER_TIMEOUT_MS=3000
JUDGE0_URL="http://localhost:2358"

# External Online Judge Connectors (Optional)
CF_API_KEY=""
CF_API_SECRET=""
